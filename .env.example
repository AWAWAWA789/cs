# CSQAQ API configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

CSQAQ_API_TOKEN=YOUR_APITOKEN_HERE
CSQAQ_BASE_URL=https://api.csqaq.com/api/v1
CSQAQ_CACHE_PATH=./data/cache

# Default sub-index for MVP validation. Set to the CSQAQ sub-index id or name.
# Example: SUB_INDEX_ID=3 or SUB_INDEX_NAME=饰品指数
SUB_INDEX_ID=
SUB_INDEX_NAME=饰品指数
